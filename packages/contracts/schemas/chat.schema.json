{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assistant.example/schemas/chat.schema.json",
  "title": "ChatContract",
  "oneOf": [
    { "$ref": "#/$defs/SessionRequest" },
    { "$ref": "#/$defs/SessionResponse" },
    { "$ref": "#/$defs/ConfigResponse" },
    { "$ref": "#/$defs/PublicChatRequest" },
    { "$ref": "#/$defs/PublicChatResponse" },
    { "$ref": "#/$defs/EntityDetailsResponse" },
    { "$ref": "#/$defs/AgentRequest" },
    { "$ref": "#/$defs/InternalAgentResponse" },
    { "$ref": "#/$defs/SearchRequest" },
    { "$ref": "#/$defs/SearchResponse" },
    { "$ref": "#/$defs/RetrieveRequest" },
    { "$ref": "#/$defs/RetrieveResponse" },
    { "$ref": "#/$defs/ResolveRequest" },
    { "$ref": "#/$defs/ResolveResponse" },
    { "$ref": "#/$defs/HealthResponse" },
    { "$ref": "#/$defs/VersionResponse" }
  ],
  "$defs": {
    "SessionRequest": {
      "type": "object",
      "required": ["expo_id", "source"],
      "properties": {
        "expo_id": { "$ref": "common.schema.json#/$defs/OpaqueId" },
        "source": {
          "type": "string",
          "enum": [
            "wechat_miniprogram_webview",
            "direct_h5",
            "qr_code",
            "other"
          ]
        },
        "entry": {
          "type": "object",
          "properties": {
            "campaign": { "type": ["string", "null"] },
            "referrer": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "SessionResponse": {
      "type": "object",
      "required": ["request_id", "success", "data", "error"],
      "properties": {
        "request_id": { "$ref": "common.schema.json#/$defs/OpaqueId" },
        "success": { "const": true },
        "data": {
          "type": "object",
          "required": [
            "session_id",
            "anonymous_user_id",
            "session_token",
            "expires_at",
            "default_conversation_id"
          ],
          "properties": {
            "session_id": { "$ref": "common.schema.json#/$defs/OpaqueId" },
            "anonymous_user_id": {
              "$ref": "common.schema.json#/$defs/OpaqueId"
            },
            "session_token": { "type": "string", "minLength": 1 },
            "expires_at": { "$ref": "common.schema.json#/$defs/DateTime" },
            "default_conversation_id": {
              "$ref": "common.schema.json#/$defs/OpaqueId"
            }
          },
          "additionalProperties": false
        },
        "error": { "type": "null" },
        "meta": { "$ref": "common.schema.json#/$defs/ApiMeta" }
      },
      "additionalProperties": false
    },
    "QuickAction": {
      "type": "object",
      "required": ["id", "label", "prompt"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/OpaqueId" },
        "label": { "type": "string", "minLength": 1 },
        "prompt": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "ConfigResponse": {
      "type": "object",
      "required": ["request_id", "success", "data", "error"],
      "properties": {
        "request_id": { "$ref": "common.schema.json#/$defs/OpaqueId" },
        "success": { "const": true },
        "data": {
          "type": "object",
          "required": [
            "assistant_name",
            "welcome_text",
            "quick_actions",
            "features",
            "config_version"
          ],
          "properties": {
            "assistant_name": { "type": "string" },
            "welcome_text": { "type": "string" },
            "quick_actions": {
              "type": "array",
              "items": { "$ref": "#/$defs/QuickAction" }
            },
            "features": {
              "type": "object",
              "required": [
                "streaming",
                "feedback",
                "citations",
                "map_highlight"
              ],
              "properties": {
                "streaming": { "type": "boolean" },
                "feedback": { "type": "boolean" },
                "citations": { "type": "boolean" },
                "map_highlight": { "type": "boolean" }
              },
              "additionalProperties": false
            },
            "config_version": { "type": "string" }
          },
          "additionalProperties": false
        },
        "error": { "type": "null" },
        "meta": { "$ref": "common.schema.json#/$defs/ApiMeta" }
      },
      "additionalProperties": false
    },
    "PublicChatRequest": {
      "type": "object",
      "required": ["conversation_id", "message", "context"],
      "properties": {
        "conversation_id": { "$ref": "common.schema.json#/$defs/OpaqueId" },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": ".*\\S.*"
        },
        "context": {
          "type": "object",
          "required": ["expo_id"],
          "properties": {
            "expo_id": { "$ref": "common.schema.json#/$defs/OpaqueId" },
            "locale": { "type": "string", "default": "zh-CN" },
            "current_hall_id": { "type": ["string", "null"], "minLength": 1 },
            "selected_entity_ids": {
              "type": "array",
              "items": { "$ref": "common.schema.json#/$defs/OpaqueId" },
              "maxItems": 20,
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "client": {
          "type": "object",
          "properties": {
            "message_id": { "$ref": "common.schema.json#/$defs/OpaqueId" },
            "supports": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["sse_v1", "entity_card_v1", "citation_v1"]
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "AnswerStatus": {
      "type": "string",
      "enum": ["answered", "clarify", "abstain", "conflict", "partial"]
    },
    "Intent": {
      "type": "string",
      "enum": [
        "faq_query",
        "exhibitor_search",
        "product_search",
        "booth_lookup",
        "event_search",
        "map_lookup",
        "recommendation",
        "multi_intent",
        "unknown"
      ]
    },
    "PublicChatData": {
      "type": "object",
      "required": [
        "conversation_id",
        "message_id",
        "answer",
        "answer_status",
        "cards",
        "citations",
        "suggestions"
      ],
      "properties": {
        "conversation_id": { "$ref": "common.schema.json#/$defs/OpaqueId" },
        "message_id": { "$ref": "common.schema.json#/$defs/OpaqueId" },
        "answer": { "type": "string" },
        "answer_status": { "$ref": "#/$defs/AnswerStatus" },
        "cards": {
          "type": "array",
          "items": { "$ref": "card.schema.json#/$defs/EntityCard" }
        },
        "citations": {
          "type": "array",
          "items": { "$ref": "citation.schema.json#/$defs/Citation" }
        },
        "suggestions": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 4
        },
        "versions": { "$ref": "common.schema.json#/$defs/PublicVersions" }
      },
      "additionalProperties": false
    },
    "PublicChatResponse": {
      "type": "object",
      "required": ["request_id", "success", "data", "error"],
      "properties": {
        "request_id": { "$ref": "common.schema.json#/$defs/OpaqueId" },
        "success": { "const": true },
        "data": { "$ref": "#/$defs/PublicChatData" },
        "error": { "type": "null" },
        "meta": { "$ref": "common.schema.json#/$defs/ApiMeta" }
      },
      "additionalProperties": false
    },
    "Hall": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/OpaqueId" },
        "name": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "ExhibitorEntity": {
      "type": "object",
      "required": ["id", "name", "hall", "booths", "status"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/OpaqueId" },
        "name": { "type": "string", "minLength": 1 },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "brands": { "type": "array", "items": { "type": "string" } },
        "hall": { "$ref": "#/$defs/Hall" },
        "booths": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/Booth" },
          "minItems": 1
        },
        "categories": { "type": "array", "items": { "type": "string" } },
        "tags": { "type": "array", "items": { "type": "string" } },
        "description": { "type": "string" },
        "status": { "const": "published" }
      },
      "additionalProperties": false
    },
    "ProductEntity": {
      "type": "object",
      "required": [
        "id",
        "name",
        "category",
        "exhibitor_id",
        "hall",
        "booths",
        "status"
      ],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/OpaqueId" },
        "name": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "functions": { "type": "array", "items": { "type": "string" } },
        "brand": { "type": "string" },
        "exhibitor_id": { "$ref": "common.schema.json#/$defs/OpaqueId" },
        "hall": { "$ref": "#/$defs/Hall" },
        "booths": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/Booth" },
          "minItems": 1
        },
        "tags": { "type": "array", "items": { "type": "string" } },
        "description": { "type": "string" },
        "status": { "const": "published" }
      },
      "additionalProperties": false
    },
    "EventEntity": {
      "type": "object",
      "required": ["id", "title", "start_at", "end_at", "venue", "status"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/OpaqueId" },
        "title": { "type": "string", "minLength": 1 },
        "start_at": { "$ref": "common.schema.json#/$defs/DateTime" },
        "end_at": { "$ref": "common.schema.json#/$defs/DateTime" },
        "venue": { "type": "string", "minLength": 1 },
        "hall": { "$ref": "#/$defs/Hall" },
        "status": {
          "type": "string",
          "enum": ["scheduled", "ongoing", "ended", "cancelled"]
        },
        "speakers": { "type": "array", "items": { "type": "string" } },
        "tags": { "type": "array", "items": { "type": "string" } },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ExhibitorEntityDetails": {
      "type": "object",
      "required": ["entity_type", "entity"],
      "properties": {
        "entity_type": { "const": "exhibitor" },
        "entity": { "$ref": "#/$defs/ExhibitorEntity" }
      },
      "additionalProperties": false
    },
    "ProductEntityDetails": {
      "type": "object",
      "required": ["entity_type", "entity"],
      "properties": {
        "entity_type": { "const": "product" },
        "entity": { "$ref": "#/$defs/ProductEntity" }
      },
      "additionalProperties": false
    },
    "EventEntityDetails": {
      "type": "object",
      "required": ["entity_type", "entity"],
      "properties": {
        "entity_type": { "const": "event" },
        "entity": { "$ref": "#/$defs/EventEntity" }
      },
      "additionalProperties": false
    },
    "EntityDetailsResponse": {
      "type": "object",
      "required": ["request_id", "success", "data", "error"],
      "properties": {
        "request_id": { "$ref": "common.schema.json#/$defs/OpaqueId" },
        "success": { "const": true },
        "data": {
          "oneOf": [
            { "$ref": "#/$defs/ExhibitorEntityDetails" },
            { "$ref": "#/$defs/ProductEntityDetails" },
            { "$ref": "#/$defs/EventEntityDetails" }
          ]
        },
        "error": { "type": "null" },
        "meta": { "$ref": "common.schema.json#/$defs/ApiMeta" }
      },
      "additionalProperties": false
    },
    "AgentRequest": {
      "type": "object",
      "required": [
        "request_id",
        "conversation_id",
        "query",
        "expo_id",
        "locale"
      ],
      "properties": {
        "request_id": { "$ref": "common.schema.json#/$defs/OpaqueId" },
        "conversation_id": { "$ref": "common.schema.json#/$defs/OpaqueId" },
        "query": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "expo_id": { "$ref": "common.schema.json#/$defs/OpaqueId" },
        "locale": { "type": "string" },
        "context": {
          "type": "object",
          "properties": {
            "current_hall_id": { "type": ["string", "null"] },
            "selected_entity_ids": {
              "type": "array",
              "items": { "$ref": "common.schema.json#/$defs/OpaqueId" },
              "maxItems": 20
            }
          },
          "additionalProperties": false
        },
        "options": {
          "type": "object",
          "properties": {
            "include_citations": { "type": "boolean" },
            "include_suggestions": { "type": "boolean" },
            "include_internal_trace": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "InternalAgentTrace": {
      "type": "object",
      "required": ["route"],
      "properties": {
        "route": {
          "type": "string",
          "enum": [
            "exact",
            "lexical",
            "fuzzy",
            "semantic",
            "hybrid",
            "retrieve",
            "none"
          ]
        },
        "normalized_query": { "type": "string" },
        "intent": { "$ref": "#/$defs/Intent" },
        "tool_calls": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["search", "retrieve", "resolve"]
          }
        }
      },
      "additionalProperties": false
    },
    "InternalAgentResponse": {
      "type": "object",
      "required": [
        "conversation_id",
        "message_id",
        "answer",
        "answer_status",
        "cards",
        "citations",
        "suggestions"
      ],
      "properties": {
        "conversation_id": {
          "$ref": "common.schema.json#/$defs/OpaqueId"
        },
        "message_id": { "$ref": "common.schema.json#/$defs/OpaqueId" },
        "answer": { "type": "string" },
        "answer_status": { "$ref": "#/$defs/AnswerStatus" },
        "cards": {
          "type": "array",
          "items": { "$ref": "card.schema.json#/$defs/EntityCard" }
        },
        "citations": {
          "type": "array",
          "items": { "$ref": "citation.schema.json#/$defs/Citation" }
        },
        "suggestions": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 4
        },
        "versions": {
          "$ref": "common.schema.json#/$defs/InternalVersions"
        },
        "internal_trace": {
          "oneOf": [
            { "$ref": "#/$defs/InternalAgentTrace" },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    },
    "SearchFilters": {
      "type": "object",
      "properties": {
        "hall_ids": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/OpaqueId" },
          "uniqueItems": true
        },
        "categories": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "status": {
          "type": "array",
          "items": { "const": "published" },
          "uniqueItems": true
        },
        "time_range": {
          "oneOf": [
            {
              "type": "object",
              "required": ["start_at", "end_at"],
              "properties": {
                "start_at": { "$ref": "common.schema.json#/$defs/DateTime" },
                "end_at": { "$ref": "common.schema.json#/$defs/DateTime" }
              },
              "additionalProperties": false
            },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    },
    "DetectedEntity": {
      "type": "object",
      "required": ["type", "value", "confidence"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["category", "capability", "brand", "hall", "booth", "time"]
        },
        "value": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "ExhibitorSearchEntity": {
      "type": "object",
      "required": ["name", "hall_id", "booth_ids"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "hall_id": { "$ref": "common.schema.json#/$defs/OpaqueId" },
        "booth_ids": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/OpaqueId" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "ProductSearchEntity": {
      "type": "object",
      "required": ["name", "exhibitor_id", "hall_id", "booth_ids"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "exhibitor_id": { "$ref": "common.schema.json#/$defs/OpaqueId" },
        "hall_id": { "$ref": "common.schema.json#/$defs/OpaqueId" },
        "booth_ids": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/OpaqueId" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "EventSearchEntity": {
      "type": "object",
      "required": ["title", "start_at", "end_at", "venue"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "start_at": { "$ref": "common.schema.json#/$defs/DateTime" },
        "end_at": { "$ref": "common.schema.json#/$defs/DateTime" },
        "venue": { "type": "string", "minLength": 1 },
        "hall_id": { "$ref": "common.schema.json#/$defs/OpaqueId" }
      },
      "additionalProperties": false
    },
    "BoothSearchEntity": {
      "type": "object",
      "required": ["display_code", "hall_id", "map_shape_id"],
      "properties": {
        "display_code": { "type": "string", "minLength": 1 },
        "hall_id": { "$ref": "common.schema.json#/$defs/OpaqueId" },
        "map_shape_id": { "$ref": "common.schema.json#/$defs/OpaqueId" }
      },
      "additionalProperties": false
    },
    "ExhibitorSearchResult": {
      "type": "object",
      "required": [
        "rank",
        "entity_type",
        "entity_id",
        "final_score",
        "relevance_grade",
        "matched_fields",
        "highlights",
        "entity"
      ],
      "properties": {
        "rank": { "type": "integer", "minimum": 1 },
        "entity_type": { "const": "exhibitor" },
        "entity_id": { "$ref": "common.schema.json#/$defs/OpaqueId" },
        "final_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "relevance_grade": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "matched_fields": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "highlights": { "type": "array", "items": { "type": "string" } },
        "entity": { "$ref": "#/$defs/ExhibitorSearchEntity" }
      },
      "additionalProperties": false
    },
    "ProductSearchResult": {
      "type": "object",
      "required": [
        "rank",
        "entity_type",
        "entity_id",
        "final_score",
        "relevance_grade",
        "matched_fields",
        "highlights",
        "entity"
      ],
      "properties": {
        "rank": { "type": "integer", "minimum": 1 },
        "entity_type": { "const": "product" },
        "entity_id": { "$ref": "common.schema.json#/$defs/OpaqueId" },
        "final_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "relevance_grade": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "matched_fields": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "highlights": { "type": "array", "items": { "type": "string" } },
        "entity": { "$ref": "#/$defs/ProductSearchEntity" }
      },
      "additionalProperties": false
    },
    "EventSearchResult": {
      "type": "object",
      "required": [
        "rank",
        "entity_type",
        "entity_id",
        "final_score",
        "relevance_grade",
        "matched_fields",
        "highlights",
        "entity"
      ],
      "properties": {
        "rank": { "type": "integer", "minimum": 1 },
        "entity_type": { "const": "event" },
        "entity_id": { "$ref": "common.schema.json#/$defs/OpaqueId" },
        "final_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "relevance_grade": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "matched_fields": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "highlights": { "type": "array", "items": { "type": "string" } },
        "entity": { "$ref": "#/$defs/EventSearchEntity" }
      },
      "additionalProperties": false
    },
    "BoothSearchResult": {
      "type": "object",
      "required": [
        "rank",
        "entity_type",
        "entity_id",
        "final_score",
        "relevance_grade",
        "matched_fields",
        "highlights",
        "entity"
      ],
      "properties": {
        "rank": { "type": "integer", "minimum": 1 },
        "entity_type": { "const": "booth" },
        "entity_id": { "$ref": "common.schema.json#/$defs/OpaqueId" },
        "final_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "relevance_grade": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "matched_fields": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "highlights": { "type": "array", "items": { "type": "string" } },
        "entity": { "$ref": "#/$defs/BoothSearchEntity" }
      },
      "additionalProperties": false
    },
    "SearchResult": {
      "oneOf": [
        { "$ref": "#/$defs/ExhibitorSearchResult" },
        { "$ref": "#/$defs/ProductSearchResult" },
        { "$ref": "#/$defs/EventSearchResult" },
        { "$ref": "#/$defs/BoothSearchResult" }
      ]
    },
    "SearchNormalizationTrace": {
      "type": "object",
      "required": ["raw", "normalized", "corrections"],
      "properties": {
        "raw": { "type": "string" },
        "normalized": { "type": "string" },
        "corrections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to", "source"],
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" },
              "source": {
                "type": "string",
                "enum": ["dictionary", "synonym", "rule"]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "SearchBranchTrace": {
      "type": "object",
      "required": ["count", "top_ids"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "top_ids": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/OpaqueId" }
        }
      },
      "additionalProperties": false
    },
    "SearchTrace": {
      "type": "object",
      "required": ["normalization", "elapsed_ms"],
      "properties": {
        "normalization": { "$ref": "#/$defs/SearchNormalizationTrace" },
        "exact": { "$ref": "#/$defs/SearchBranchTrace" },
        "lexical": { "$ref": "#/$defs/SearchBranchTrace" },
        "semantic": { "$ref": "#/$defs/SearchBranchTrace" },
        "fusion": {
          "type": "object",
          "required": ["method", "candidate_count"],
          "properties": {
            "method": { "type": "string", "minLength": 1 },
            "candidate_count": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "rerank": {
          "type": "object",
          "required": ["input_count", "output_count", "model"],
          "properties": {
            "input_count": { "type": "integer", "minimum": 0 },
            "output_count": { "type": "integer", "minimum": 0 },
            "model": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "elapsed_ms": {
          "type": "object",
          "required": ["total"],
          "properties": {
            "total": { "type": "integer", "minimum": 0 },
            "exact": { "type": "integer", "minimum": 0 },
            "lexical": { "type": "integer", "minimum": 0 },
            "semantic": { "type": "integer", "minimum": 0 },
            "rerank": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "SearchVersions": {
      "type": "object",
      "required": ["search", "index"],
      "properties": {
        "search": { "type": "string", "minLength": 1 },
        "index": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "SearchRequest": {
      "type": "object",
      "required": [
        "request_id",
        "expo_id",
        "query",
        "entity_types",
        "search_mode"
      ],
      "properties": {
        "request_id": { "$ref": "common.schema.json#/$defs/OpaqueId" },
        "expo_id": { "$ref": "common.schema.json#/$defs/OpaqueId" },
        "query": { "type": "string", "minLength": 1, "maxLength": 500 },
        "entity_types": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/EntityType" },
          "minItems": 1,
          "uniqueItems": true
        },
        "search_mode": {
          "type": "string",
          "enum": ["auto", "exact", "lexical", "fuzzy", "semantic", "hybrid"]
        },
        "filters": { "$ref": "#/$defs/SearchFilters" },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 10
        },
        "include_trace": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "SearchResponse": {
      "type": "object",
      "required": [
        "request_id",
        "route",
        "normalized_query",
        "detected_entities",
        "results",
        "trace",
        "versions"
      ],
      "properties": {
        "request_id": { "$ref": "common.schema.json#/$defs/OpaqueId" },
        "route": {
          "type": "string",
          "enum": ["exact", "lexical", "fuzzy", "semantic", "hybrid"]
        },
        "normalized_query": { "type": "string" },
        "detected_entities": {
          "type": "array",
          "items": { "$ref": "#/$defs/DetectedEntity" }
        },
        "results": {
          "type": "array",
          "items": { "$ref": "#/$defs/SearchResult" }
        },
        "trace": {
          "oneOf": [{ "$ref": "#/$defs/SearchTrace" }, { "type": "null" }]
        },
        "versions": { "$ref": "#/$defs/SearchVersions" }
      },
      "additionalProperties": false
    },
    "RetrieveFilters": {
      "type": "object",
      "properties": {
        "status": {
          "type": "array",
          "items": { "const": "published" },
          "uniqueItems": true
        },
        "effective_at": { "$ref": "common.schema.json#/$defs/DateTime" }
      },
      "additionalProperties": false
    },
    "ChunkMetadata": {
      "type": "object",
      "required": ["effective_from", "effective_to"],
      "properties": {
        "effective_from": { "type": "string", "format": "date" },
        "effective_to": {
          "oneOf": [{ "type": "string", "format": "date" }, { "type": "null" }]
        }
      },
      "additionalProperties": false
    },
    "RetrieveTrace": {
      "type": "object",
      "required": ["route", "elapsed_ms"],
      "properties": {
        "route": {
          "type": "string",
          "enum": ["lexical", "semantic", "hybrid"]
        },
        "elapsed_ms": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "RetrieveRequest": {
      "type": "object",
      "required": ["request_id", "expo_id", "query", "scope", "mode"],
      "properties": {
        "request_id": { "$ref": "common.schema.json#/$defs/OpaqueId" },
        "expo_id": { "$ref": "common.schema.json#/$defs/OpaqueId" },
        "query": { "type": "string", "minLength": 1, "maxLength": 500 },
        "scope": {
          "type": "array",
          "items": { "type": "string", "enum": ["faq", "document"] },
          "minItems": 1,
          "uniqueItems": true
        },
        "filters": { "$ref": "#/$defs/RetrieveFilters" },
        "mode": { "type": "string", "enum": ["lexical", "semantic", "hybrid"] },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 8
        },
        "include_trace": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "RetrieveResponse": {
      "type": "object",
      "required": ["request_id", "chunks", "versions"],
      "properties": {
        "request_id": { "$ref": "common.schema.json#/$defs/OpaqueId" },
        "chunks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "chunk_id",
              "source_id",
              "source_title",
              "section",
              "page_or_row",
              "text",
              "final_score",
              "relevance_grade",
              "metadata"
            ],
            "properties": {
              "chunk_id": { "$ref": "common.schema.json#/$defs/OpaqueId" },
              "source_id": { "$ref": "common.schema.json#/$defs/OpaqueId" },
              "source_title": { "type": "string" },
              "section": { "type": "string" },
              "page_or_row": { "type": "string" },
              "text": { "type": "string" },
              "final_score": { "type": "number", "minimum": 0, "maximum": 1 },
              "relevance_grade": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              },
              "metadata": { "$ref": "#/$defs/ChunkMetadata" }
            },
            "additionalProperties": false
          }
        },
        "versions": { "$ref": "common.schema.json#/$defs/InternalVersions" },
        "trace": {
          "oneOf": [{ "$ref": "#/$defs/RetrieveTrace" }, { "type": "null" }]
        }
      },
      "additionalProperties": false
    },
    "ResolveRequest": {
      "type": "object",
      "required": [
        "request_id",
        "expo_id",
        "mention",
        "entity_types",
        "strict"
      ],
      "properties": {
        "request_id": { "$ref": "common.schema.json#/$defs/OpaqueId" },
        "expo_id": { "$ref": "common.schema.json#/$defs/OpaqueId" },
        "mention": { "type": "string", "minLength": 1 },
        "entity_types": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/EntityType" },
          "minItems": 1
        },
        "strict": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "ResolveResponse": {
      "type": "object",
      "required": ["resolution", "normalized_mention", "candidates"],
      "properties": {
        "resolution": {
          "type": "string",
          "enum": ["unique", "ambiguous", "not_found"]
        },
        "normalized_mention": { "type": "string" },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["entity_type", "entity_id", "confidence"],
            "properties": {
              "entity_type": { "$ref": "common.schema.json#/$defs/EntityType" },
              "entity_id": { "$ref": "common.schema.json#/$defs/OpaqueId" },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "HealthResponse": {
      "type": "object",
      "required": ["status", "dependencies"],
      "properties": {
        "status": { "type": "string", "enum": ["ok", "degraded", "down"] },
        "dependencies": {
          "type": "object",
          "required": ["database", "search", "vector_store", "llm"],
          "properties": {
            "database": {
              "type": "string",
              "enum": ["ok", "degraded", "down"]
            },
            "search": { "type": "string", "enum": ["ok", "degraded", "down"] },
            "vector_store": {
              "type": "string",
              "enum": ["ok", "degraded", "down"]
            },
            "llm": { "type": "string", "enum": ["ok", "degraded", "down"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "VersionResponse": {
      "type": "object",
      "required": [
        "service",
        "service_version",
        "search_version",
        "kb_version",
        "prompt_version",
        "index_versions"
      ],
      "properties": {
        "service": { "type": "string" },
        "service_version": { "type": "string" },
        "search_version": { "type": "string" },
        "kb_version": { "type": "string" },
        "prompt_version": { "type": "string" },
        "model_version": { "type": "string" },
        "index_versions": {
          "type": "object",
          "required": ["entities", "documents"],
          "properties": {
            "entities": { "type": "string" },
            "documents": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
