      "transport": { "http_status": 200, "initial_delay_ms": 0 },
      "expect": {
        "terminal": "done",
        "semantic": {
          "card_type": "exhibitor",
          "required_events": ["entity.card", "citation", "suggestion.list"],
          "source_ids": ["source_exhibitors_2026"]
        }
      }
    },
