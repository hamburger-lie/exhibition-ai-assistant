NODE_ENV=development
VITE_API_BASE_URL=http://localhost:3000
BFF_HOST=127.0.0.1
BFF_PORT=3000
B_SERVICE_BASE_URL=http://localhost:3001
MOCK_B_HOST=127.0.0.1
MOCK_B_PORT=3001
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/assistant?schema=public
BFF_CORS_ALLOWED_ORIGINS=http://localhost:5173
BFF_RATE_LIMIT_WINDOW_MS=60000
BFF_RATE_LIMIT_MAX=120
B_SERVICE_TIMEOUT_MS=30000
BFF_SERVICE_VERSION=0.0.0-dev
BFF_LOG_LEVEL=info
# 会话与限流的共享存储（多实例部署必须用 redis；memory 仅供单元测试）
BFF_STORE_BACKEND=redis
REDIS_URL=redis://127.0.0.1:6379
# E07 实体详情数据源：fixture=本地结构化样例；none=未配置（返回 UPSTREAM_UNAVAILABLE）
# 未显式设置时，NODE_ENV=production 默认 none，其余默认 fixture
BFF_ENTITY_DETAIL_PROVIDER=fixture
