{
  "name": "@ai-assistant/bff",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "prisma:generate": "prisma generate --schema src/persistence/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema src/persistence/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema src/persistence/schema.prisma"
  },
  "dependencies": {
    "@ai-assistant/demo-catalog": "workspace:*",
    "@ai-assistant/sse": "workspace:*",
    "@prisma/client": "^5.22.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.5.0",
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
